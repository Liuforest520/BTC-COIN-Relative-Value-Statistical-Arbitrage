# Repository allowlist: ignore everything unless it is explicitly kept below.
*

# Project metadata and top-level documentation.
!.gitignore
!.gitattributes
!.github/
!.github/**
!README.md
!LICENSE
!LICENSE.*
!CHANGELOG.md
!CONTRIBUTING.md
!requirements.txt
!pyproject.toml
!pytest.ini
!ruff.toml
!mypy.ini

# Application source code.
!core/
!core/**

# Runnable scripts and automated tests.
!scripts/
!scripts/**
!test/
!test/**

# Maintenance and research source code only.
!maintenance/
!maintenance/**
!research/
/research/*
!/research/scripts/
!/research/scripts/**

# Configuration is machine-local and deliberately kept out of the repository.
# This covers config/config.yaml, config/archive/, config/sweeps/,
# config/tls_huber_selected_12/ and every generated configuration tree.
# The loader falls back to dataclass defaults for absent keys.
/config/

# Credentials and machine-local configuration must never be committed.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*credentials*
*secrets*
/config/mysql.config
/config/*.config

# Market data, research documents, dependencies, logs and generated outputs.
/data/
/documents/
/logs/
/node_modules/
/output/
/outputs/
/results/
/tmp/
/优化/

# Generated configuration trees.
/config/sweep.yaml
/config/generated/
/config/sweeps/**/generated/

# Generated research data; research source scripts are allowed above.
/research/data/
/research/outputs/

# Python environments, caches, coverage and build artifacts.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Local databases and temporary files.
*.db
*.sqlite
*.sqlite3
*.log
*.tmp
*.temp
*.bak

# Editors and operating-system files.
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini
